FROM ghcr.io/ralphke/agentic-coding-image:latest
# Custom image: build with extentions for this repo based on Microsoft devcontainers base
# The vsc-* local hash image only exists on the developer's machine and cannot be
# pulled in CI; this Dockerfile targets the public upstream image instead.

# Fix system-level vulnerabilities and resolve dpkg conflicts
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && \
    dpkg --configure -a && \
    apt-get install -f -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.title="agentic-coding-image" \
    org.opencontainers.image.description="Container image for Agentic-Coding" \
    org.opencontainers.image.source="https://github.com/ralphke/Agentic-Coding" \
    org.opencontainers.image.url="https://github.com/ralphke/Agentic-Coding" \
    org.opencontainers.image.documentation="https://github.com/ralphke/Agentic-Coding#readme" \
    org.opencontainers.image.vendor="ralphke" \
    org.opencontainers.image.licenses="MIT"