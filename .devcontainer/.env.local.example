# Copy to .env.local and set values for your local machine only.
# This file is intentionally not used directly by devcontainer.json.
# Use load-localenv.ps1 to persist variables to your user environment.

# Optional extra host folder to mount when using devcontainer.local.json
# Windows example: D:\\devcontainer-data
# macOS example: /Users/yourname/devcontainer-data
DEVCONTAINER_HOST_DATA_PATH=/devcontainer-data
