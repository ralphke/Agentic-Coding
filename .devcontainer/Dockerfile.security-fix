FROM vsc-agentic-coding-90b20fc2c7ebd922c7765dca321d4b38f103999d96731b1f783a1facbd615b2e-features:latest
# docker compose -f docker-compose.yml build 2>&1
# Fix system-level vulnerabilities
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --only-upgrade linux-image-generic && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Update Golang if present in the build
RUN if command -v go &> /dev/null; then \
    echo "Go detected - consider upgrading from $(go version)" && \
    apt-get update && \
    apt-get install -y golang-1.22 && \
    update-alternatives --install /usr/bin/go go /usr/lib/go-1.22/bin/go 100 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*; \
    fi

USER root
