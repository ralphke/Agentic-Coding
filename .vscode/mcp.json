{
  // TODO: Register the centrally hosted Customers Secure Coding MCP here when the BCP endpoint and authentication details are available.
  "servers": {
    "openspec-filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${workspaceFolder}/spec/openspec"
      ],
      "description": "Read/write access to the OpenSPEC spec folder. Used by all Software Fabric agent personas to manage specs, proposals, designs, and tasks."
    },
    "github-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@github/github-mcp-server"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:githubToken}"
      },
      "description": "GitHub API access for creating/updating issues, PRs, labels, and triggering workflows in the Software Fabric pipeline."
    }
  },
  "inputs": [
    {
      "id": "githubToken",
      "type": "promptString",
      "description": "GitHub Personal Access Token (repo, issues, workflow scopes required)",
      "password": true
    }
  ],
  "comments": {
    "openspec-cli": "The OpenSpec CLI (npm install -g @fission-ai/openspec) provides the /opsx:* commands. It is NOT an MCP server — install it globally and use via VS Code Copilot chat slash commands.",
    "openspec-setup": [
      "Install: npm install -g @fission-ai/openspec@latest",
      "Then in this repo: openspec init (or point to spec/openspec with --specs-dir)",
      "Commands: /opsx:propose, /opsx:apply, /opsx:sync, /opsx:archive"
    ],
    "filesystem-mcp": "The @modelcontextprotocol/server-filesystem MCP server gives AI agents direct read/write access to the spec folder without leaving the chat interface.",
    "github-mcp": "The GitHub MCP server allows AI agents to create issues, add labels, and trigger workflows directly, enabling fully autonomous SDLC handoffs."
  }
}